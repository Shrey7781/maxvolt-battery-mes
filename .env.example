POSTGRES_DB=mes
POSTGRES_USER=mes
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg://mes:change-me@db:5432/mes

# Real (AWS) deployment only: leave unset for local/dev. When set,
# DATABASE_URL above is ignored — credentials are fetched instead from an
# AWS Secrets Manager secret in RDS's "manage master credentials in
# Secrets Manager" format ({"username":..,"password":..,"host":..,"port":..}
# — no dbname, hence DB_NAME below). Requires the ECS task role / EC2
# instance profile to have secretsmanager:GetSecretValue on this ARN — no
# AWS access keys go in this file.
# DB_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:NAME
DB_NAME=mes

LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120
ENVIRONMENT=production
