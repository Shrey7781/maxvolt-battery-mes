POSTGRES_DB=mes
POSTGRES_USER=mes
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg://mes:change-me@db:5432/mes

# IMPORTANT: app/config.py currently defaults DB_SECRET_ARN/DB_NAME to the
# real production secret/database (a stopgap because there's no env-var
# access on the ECS task definition — see the comment there). This line
# MUST stay present and empty in your local .env, or `docker compose up`
# will try to hit the production AWS secret instead of your local db.
DB_SECRET_ARN=
DB_NAME=mes

LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120

# Keeps /docs, /redoc and /openapi.json enabled for local dev — main.py
# disables them once ENVIRONMENT=production (the real-deployment default).
ENVIRONMENT=development
